# Salin berkas ini menjadi .env lalu sesuaikan. Semua nilai punya default
# yang masuk akal, jadi backend tetap jalan walau .env belum dibuat.

PORT=4000
DB_PATH=./lokalboost.db
FOLDER_UNGGAHAN=./unggahan

# Ganti di produksi. Token yang ditandatangani dengan kunci default
# bisa dipalsukan siapa pun yang membaca repositori ini.
JWT_SECRET=lokalboost-rahasia-pengembangan
JWT_KEDALUWARSA=7d

# Origin frontend yang boleh memanggil API (pisahkan dengan koma).
# Tujuan tombol di dalam email notifikasi. Kosong = pakai asal pertama di
# ASAL_DIIZINKAN, yang di produksi memang alamat frontend-nya.
ALAMAT_SITUS=

ASAL_DIIZINKAN=http://localhost:5173,http://localhost:4173

# Komisi platform per pencairan, dalam persen.
# PRD §15 menandai angka ini sebagai pertanyaan terbuka.
KOMISI_PERSEN=5

# Ambang AI Anti-Fraud.
AF_DURASI_MIN=3        # detik minimum sebuah tayangan dianggap sah
AF_MAKS_VIEW_IP=3      # maksimal tayangan per alamat IP dalam satu jendela
AF_JENDELA_ULANG=60    # panjang jendela tersebut, dalam menit
AF_AMBANG_Z=3          # z-score minimum sebelum satu jam disebut anomali

# Kosongkan untuk memakai template (backend tetap jalan penuh tanpa internet).
#
# Kunci dibuat di https://console.anthropic.com/settings/keys — ada biaya per
# panggilan. Setelah diisi, jalankan `npm run cek-ai` untuk MEMBUKTIKAN jalur
# LLM-nya benar-benar hidup: services/ai.js sengaja tidak pernah gagal, jadi
# kunci yang salah hanya terlihat sebagai hasil template yang tetap masuk akal.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Penyedia dicoba BERURUTAN: NaraRouter, lalu OpenRouter, lalu Anthropic.
# Kalau yang pertama gagal atau mentok batas waktu, yang berikutnya dicoba;
# barulah kalau semuanya gagal, template dipakai. Isi minimal satu.
#
# MODELNYA WAJIB MENDUKUNG structured_outputs. Ini bukan formalitas: seluruh
# fitur AI meminta JSON berskema ketat, dan model yang tidak mendukungnya
# menolak dengan HTTP 400 berpesan menyesatkan soal "input yang dikirim".
# Model vision khususnya sering begitu. Model gratis yang mendukungnya bisa
# disaring dari https://openrouter.ai/api/v1/models, cari yang
# supported_parameters memuat "structured_outputs".
#
# Setelah diisi, jalankan `npm run cek-ai` untuk MEMBUKTIKAN jalurnya hidup.
# services/ai.js sengaja tidak pernah melempar ke pengguna, jadi kunci atau
# model yang salah hanya terlihat sebagai hasil template yang tetap masuk akal.
NARA_API_KEY=
NARA_BASE_URL=https://router.bynara.id/v1
NARA_MODEL=nemotron-3-super-free
# 'off' mematikan penalaran. Dengan penalaran menyala, model NaraRouter
# membalas message.content KOSONG pada permintaan berskema.
NARA_REASONING=off

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free

# Batas tunggu PER PENYEDIA, dalam detik. Harus jauh di bawah maxDuration
# fungsi Vercel (30 detik), sebab satu permintaan bisa mencoba dua penyedia
# berurutan. Bawaannya 12.
AI_BATAS_DETIK=12

# ---------------------------------------------------------------------------
# SMTP — kirim kode verifikasi ke email sungguhan.
# Kosongkan semuanya kalau ingin kode cukup dicetak ke log server (mode demo).
#
# Gmail: aktifkan verifikasi 2 langkah di akun Google, lalu buat App Password
# di https://myaccount.google.com/apppasswords dan tempel 16 hurufnya di
# SMTP_SANDI (spasi boleh, nanti dibuang otomatis). Sandi Gmail biasa DITOLAK.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_PENGGUNA=emailkamu@gmail.com
SMTP_SANDI=
SMTP_DARI=LokalBoost <emailkamu@gmail.com>

# Setel false agar kode OTP TIDAK ikut dikembalikan di respons API,
# jadi satu-satunya cara mendapatkannya adalah membuka inbox.
BOCORKAN_OTP=true

# Way (way.gutech.dev), gateway OpenAI-compatible. Kalau diisi, jadi cadangan
# tepat setelah Gemini (Way lebih lambat). Base URL bawaan sudah benar.
WAY_API_KEY=
WAY_MODEL=gemini-4-argon

# Penyedia berikutnya. Kosong = lompat ke Nara/OpenRouter.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Midtrans Snap (setor dana Rekber). Kosong = setor dana simulasi.
# Kunci sandbox: dashboard.sandbox.midtrans.com > Settings > Access Keys
# Notification URL di dashboard: https://<situs>/api/pembayaran/notifikasi
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# MIDTRANS_PRODUKSI=ya  # HANYA untuk uang sungguhan

# Cek Profil Kreator (ukur pengikut/views/engagement dari tautan profil
# TikTok & Instagram). Kunci dari https://app.scrapecreators.com (ada kredit
# gratis untuk mencoba). 1 cek TikTok = 2 kredit, Instagram = 1 kredit.
# Kosong = fitur mati, kreator tetap bisa isi statistik manual.
SCRAPECREATORS_API_KEY=
